<Window x:Class="BatteryStatus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Status" Width="440" MinWidth="400"
        SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24">
    <TextBlock Text="Battery status" FontSize="24" FontWeight="SemiBold" />
    <TextBlock x:Name="ChargeText" Margin="0,16,0,0" FontSize="40" FontWeight="SemiBold" />
    <TextBlock x:Name="PowerText" Margin="0,0,0,10" TextWrapping="Wrap" />
    <ProgressBar x:Name="ChargeBar" Height="8" Minimum="0" Maximum="100"
                 AutomationProperties.Name="Battery charge percentage" />
    <Separator Margin="0,20,0,14" />

    <TextBlock Text="Charge reminders" FontSize="17" FontWeight="SemiBold" />
    <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
      <CheckBox x:Name="HighEnabled" Content="While plugged in, alert at or above" Width="230"
                VerticalAlignment="Center" />
      <TextBox x:Name="HighInput" Width="48" MaxLength="3"
               AutomationProperties.Name="Plugged-in alert percentage" />
      <TextBlock Text="%" Margin="5,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
      <CheckBox x:Name="LowEnabled" Content="While unplugged, alert at or below" Width="230"
                VerticalAlignment="Center" />
      <TextBox x:Name="LowInput" Width="48" MaxLength="3"
               AutomationProperties.Name="Unplugged alert percentage" />
      <TextBlock Text="%" Margin="5,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
    <Button Content="Save alerts" Click="SaveAlerts" HorizontalAlignment="Left"
            Margin="0,12,0,0" Padding="12,4" />
    <TextBlock x:Name="SettingsMessage" Margin="0,8,0,0" TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="Closing this window keeps Battery Status in the system tray."
               TextWrapping="Wrap" Margin="0,12,0,0" />
  </StackPanel>
</Window>
